<!-- ========================================================= -->
<!-- FILE: Views/LoginWindow.xaml -->
<!-- ========================================================= -->

<Window x:Class="RBLBankApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RBL Bank Login"
        Height="520"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FC">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE -->

        <Border Grid.Column="0"
                Background="#0D47A1">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="🏦 RBL BANK"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Secure Banking Management System"
                           FontSize="16"
                           Foreground="#D6E4FF"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- RIGHT SIDE -->

        <Grid Grid.Column="1">

            <Border Width="380"
                    Padding="35"
                    Background="White"
                    CornerRadius="15"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Welcome Back"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0D47A1"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Login to continue"
                               Margin="0,5,0,25"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>

                    <!-- USERNAME -->

                    <TextBlock Text="Username"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="txtUsername"
                             Height="40"
                             Margin="0,5,0,15"
                             Padding="10"/>

                    <!-- PASSWORD -->

                    <TextBlock Text="Password"
                               FontWeight="SemiBold"/>

                    <PasswordBox x:Name="txtPassword"
                                 Height="40"
                                 Margin="0,5,0,20"
                                 Padding="10"/>

                    <!-- ERROR -->

                    <TextBlock x:Name="txtError"
                               Foreground="Red"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               TextAlignment="Center"/>

                    <!-- LOGIN BUTTON -->

                    <Button Content="LOGIN"
                            Height="45"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#1565C0"
                            Foreground="White"
                            Click="Login_Click"/>

                    <!-- REGISTER -->

                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,20,0,0">

                        <Run Text="Don't have an account? "/>

                        <Hyperlink Click="GoToRegister_Click">
                            Register Here
                        </Hyperlink>

                    </TextBlock>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>