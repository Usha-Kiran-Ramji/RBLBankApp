<!-- ========================================================= -->
<!-- FILE: Views/RegisterWindow.xaml -->
<!-- ========================================================= -->

<Window x:Class="RBLBankApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register User"
        Height="672"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F7FC">

    <Grid>

        <Border Width="420"
                Padding="35"
                Background="White"
                CornerRadius="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <!-- HEADER -->

                <TextBlock Text="🏦 Create Account"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0D47A1"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Register your banking account"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,8,0,25"
                           HorizontalAlignment="Center"/>

                <!-- FULL NAME -->

                <TextBlock Text="Full Name"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>

                <TextBox x:Name="txtFullName"
                         Height="42"
                         Margin="0,6,0,16"
                         Padding="12"
                         FontSize="14"/>

                <!-- USERNAME -->

                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>

                <TextBox x:Name="txtUsername"
                         Height="42"
                         Margin="0,6,0,16"
                         Padding="12"
                         FontSize="14"/>

                <!-- EMAIL -->

                <TextBlock Text="Email Address"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>

                <TextBox x:Name="txtEmail"
                         Height="42"
                         Margin="0,6,0,16"
                         Padding="12"
                         FontSize="14"/>

                <!-- PASSWORD -->

                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"/>

                <Grid Margin="0,6,0,18">

                    <PasswordBox x:Name="txtPassword"
                                 Height="42"
                                 Padding="12"
                                 FontSize="14"/>

                    <Button Content="👁"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            FontSize="16"
                            Click="TogglePassword_Click"/>

                </Grid>

                <!-- ERROR -->

                <TextBlock x:Name="txtError"
                           Foreground="#D32F2F"
                           FontWeight="Bold"
                           Margin="0,0,0,15"
                           TextAlignment="Center"/>

                <!-- REGISTER BUTTON -->

                <Button Content="REGISTER"
                        Height="48"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#1565C0"
                        BorderBrush="Transparent"
                        Cursor="Hand"
                        Click="Register_Click">

                    <Button.Style>

                        <Style TargetType="Button">

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="10">

                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </Button.Style>

                </Button>

                <!-- LOGIN HERE SECTION -->

                <Border Background="#F5F7FA"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,22,0,0">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <!-- ICON -->

                        <TextBlock Text="🔐"
                                   FontSize="18"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>

                        <!-- TEXT -->

                        <TextBlock FontSize="14"
                                   VerticalAlignment="Center">

                            <Run Text="Already have an account? "
                                 Foreground="Gray"/>

                            <Hyperlink Click="GoToLogin_Click"
                                       Foreground="#1565C0">

                                <Bold>Login Here</Bold>

                            </Hyperlink>

                        </TextBlock>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</Window>