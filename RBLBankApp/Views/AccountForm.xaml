<Window x:Class="RBLBankApp.Views.AccountForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundLight}"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Bank Account Details" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="User ID" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUserID" Height="35" Padding="5" Margin="0,0,0,15" ToolTip="Enter User ID for this account"/>

            <TextBlock Text="Account Number" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAccountNumber" Height="35" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Initial Balance (₹)" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtBalance" Height="35" Padding="5" Margin="0,0,0,25"/>

            <Button Content="Create Account" Style="{StaticResource PrimaryButton}" Height="40" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
