<Window x:Class="RBLBankApp.Views.TransactionForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Funds" Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" ResizeMode="NoResize">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Transfer Money" FontSize="22" FontWeight="Bold" Foreground="#002366" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="From Account ID" Foreground="#002366" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFromAccount" Height="30" Padding="5" Margin="0,0,0,10" ToolTip="Enter Sender Account Number"/>

            <TextBlock Text="To Account ID" Foreground="#002366" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtToAccount" Height="30" Padding="5" Margin="0,0,0,10" ToolTip="Enter Receiver Account Number"/>

            <TextBlock Text="Amount (₹)" Foreground="#002366" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAmount" Height="30" Padding="5" Margin="0,0,0,15"/>

            <Button Content="Transfer" Height="35" Background="#ff0033" Foreground="White" FontWeight="Bold" Click="Transfer_Click" BorderBrush="Transparent"/>
        </StackPanel>
    </Grid>
</Window>