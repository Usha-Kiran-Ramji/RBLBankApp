<Window x:Class="RBLBankApp.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RBL Bank" Height="500" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#f4f6f9">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="4" Opacity="0.3"/>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#ff0033"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#cc0029"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 🔵 Left Branding -->
        <Grid Width="400" Background="#002366" HorizontalAlignment="Left">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <TextBlock Text="RBL Bank" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Secure Banking System" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ⚪ Right Card with animation -->
        <Border x:Name="CardBorder" Width="320" Background="White" CornerRadius="10" Padding="20" HorizontalAlignment="Right" Margin="0,0,80,0" VerticalAlignment="Center" Effect="{StaticResource CardShadow}">
            <Grid ClipToBounds="True">
                <!-- Forms container for sliding -->
                <StackPanel x:Name="FormsContainer" Orientation="Horizontal">
                    <StackPanel x:Name="LoginForm" Width="320"/>
                    <StackPanel x:Name="RegisterForm" Width="320"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
